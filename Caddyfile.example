# Caddy 反向代理示例。放到你的 Caddyfile 里。
# SSE (/api/stream) 无需额外配置，Caddy 默认不缓冲、支持流式。

radar.example.com {
    encode zstd gzip

    # 可选：整站 Basic Auth（雷达是只读监控，公网暴露建议加一层口令）。
    # 生成密码哈希：caddy hash-password --plaintext '你的密码'
    # 然后把下面的 用户名 和 哈希 替换掉，取消注释即可。
    # basic_auth {
    #     admin JDJhJDE0J...（caddy hash-password 生成的 bcrypt 哈希）
    # }

    reverse_proxy 127.0.0.1:8787
}
