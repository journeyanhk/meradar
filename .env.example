# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ---- 启用的链适配器（逗号分隔）。先只跑 bsc，Arc / Robinhood 待命 ----
CHAINS=bsc
# CHAINS=bsc,arc
# CHAINS=bsc,robinhood

# ---- BSC RPC ----
# 默认公共 RPC 用 publicnode：它同时开放 eth_getLogs（bsc-dataseed 会拒绝日志查询）。
# 不稳/限流再换付费 RPC（QuickNode/Alchemy/GetBlock，含 WS）。
BSC_HTTP=https://bsc-rpc.publicnode.com
# WebSocket 是监控命脉。公共 WS 常不稳，强烈建议填付费 WS。可逗号分隔多路(主路,第二路)，断线自动切换。
BSC_WS=wss://bsc-rpc.publicnode.com
# 可选：getLogs/回填 专用端点（留空回落 BSC_HTTP）。publicnode 目前稳定，一般不必填。
# BSC_LOGS_HTTP=

# ---- Arc 主网 RPC（CHAINS 含 arc 时才需要；chainId 5042，v4 pool-first）----
ARC_HTTP=https://rpc.mainnet.arc.io
ARC_WS=wss://rpc.mainnet.arc.io            # 有 Alchemy 加第二路: ,wss://arc-mainnet.g.alchemy.com/v2/<KEY>
ARC_READ_HTTP=https://rpc.mainnet.arc.io   # 只读(getCode/往返模拟)；官方支持 stateOverride
ARC_LOGS_HTTP=https://rpc.mainnet.arc.io   # getLogs 回填(分段 ≤1500 块)；或换 Alchemy arc-mainnet

# ---- Robinhood Chain RPC（CHAINS 含 robinhood 时才需要；不填走内置公共默认）----
# 官方 HTTP 做兜底；dRPC 公共 WS 做实时订阅；只读走 dRPC；回填走 Alchemy(见下)。
ROBINHOOD_HTTP=https://rpc.mainnet.chain.robinhood.com
# 只读调用(name/symbol/multicall/往返)走 dRPC，比官方公共端点稳、不易 429；留空则回落 ROBINHOOD_HTTP。
ROBINHOOD_READ_HTTP=https://robinhood.drpc.org
# WS 主路 dRPC + 第二路 Alchemy(逗号分隔)：主路断线/限流自动切第二路，事件不漏。
# 第二路把 <KEY> 换成 Alchemy 控制台的 API Key（Alchemy → Apps → Robinhood 网络 → API Key）。
ROBINHOOD_WS=wss://robinhood.drpc.org,wss://robinhood-mainnet.g.alchemy.com/v2/<KEY>
# getLogs/回填 专用端点：官方公共端点密集查询会 429，指向 Alchemy 免费额度足够承接回填。留空回落 ROBINHOOD_HTTP。
ROBINHOOD_LOGS_HTTP=https://robinhood-mainnet.g.alchemy.com/v2/<KEY>

# ---- Telegram（必需，承载 T1-T3 全量告警）----
# @BotFather 建 bot 拿 token；给 bot 发条消息后访问
# https://api.telegram.org/bot<token>/getUpdates 拿 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Server酱（必需，只走 T2/T3 高价值告警）----
# sct.ftqq.com 微信扫码登录复制 SendKey（SCT 开头）
SERVERCHAN_SENDKEY=
