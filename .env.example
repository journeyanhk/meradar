# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ---- 启用的链适配器（逗号分隔）。先只跑 bsc，Arc 待命 ----
CHAINS=bsc
# CHAINS=bsc,arc

# ---- BSC RPC ----
# 先用公共 RPC 跑通；不稳/限流再换成付费 RPC（QuickNode/Alchemy/GetBlock，含 WS）
BSC_HTTP=https://bsc-dataseed.bnbchain.org
# WebSocket 是监控命脉。公共 WS 常不稳，强烈建议填付费 WS。
BSC_WS=wss://bsc-rpc.publicnode.com

# ---- Arc 测试网 RPC（CHAINS 含 arc 时才需要）----
ARC_HTTP=https://rpc.testnet.arc.network
ARC_WS=wss://rpc.testnet.arc.network

# ---- Telegram（必需，承载 T1-T3 全量告警）----
# @BotFather 建 bot 拿 token；给 bot 发条消息后访问
# https://api.telegram.org/bot<token>/getUpdates 拿 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Server酱（必需，只走 T2/T3 高价值告警）----
# sct.ftqq.com 微信扫码登录复制 SendKey（SCT 开头）
SERVERCHAN_SENDKEY=
